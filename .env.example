# Copy this file to .env and fill in your values. Never commit .env.

# --- Required ---
GROQ_API_KEY=
PINECONE_API_KEY=

# --- Vector store ---
INDEX_NAME=company-policies
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Models ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=openai/gpt-oss-20b
SAFETY_MODEL=openai/gpt-oss-safeguard-20b
ENABLE_LLM_MODERATION=true
LLM_TEMPERATURE=0.1

# --- Retrieval ---
TOP_K=8
CANDIDATE_K=20
# Passages scoring below this are ignored; the bot says it can't find an answer instead of guessing.
# Calibrate with: python -m eval.retrieval_eval
MIN_RELEVANCE=0.55
MAX_CHUNK_WORDS=200

# --- Access control & safety ---
# Leave APP_PASSWORD empty for no login. ADMIN_PASSWORD enables the Oversight Dashboard page.
APP_PASSWORD=
ADMIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=10
MAX_QUESTION_CHARS=1000
# Kill switch: set to true to take the assistant offline immediately.
MAINTENANCE_MODE=false

# --- Privacy: PII types removed (ssn, credit_card, iban, email, phone) ---
DOCUMENT_PII_TYPES=ssn,credit_card,iban
QUESTION_PII_TYPES=ssn,credit_card,iban,email,phone
ANSWER_PII_TYPES=ssn,credit_card,iban

# --- Accountability ---
LOG_DIR=logs
LOG_RETENTION_DAYS=90
ESCALATION_CONTACT=People Operations or the relevant policy owner

DATA_DIR=data
